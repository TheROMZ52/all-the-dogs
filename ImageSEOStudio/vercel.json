{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/images",
      "destination": "/api/images"
    },
    {
      "source": "/image/:slug",
      "destination": "/api/image/:slug"
    }
  ]
}
